INSERT INTO AL_CONFIGURATION VALUES('VERSION','7.2.0')
INSERT INTO AL_TABLES VALUES('categorias',NULL,'Perfil de cada categoria de corredor (categoria = constante ELITE..PRINCIPIANTE de Corredor). tiempo_neto_max_min: corte por tiempo neto real (3 / 17 / 50 / 30 % de los corredores). Cadencia (pasos/min) y zancada (m): normal(desvio, media) con un minimo. tolerancia_calor, propension e intervalo_toma_km: uniforme entre min y max. Ver Corredor.inicializar().')
INSERT INTO AL_TABLES VALUES('corredores',NULL,'Corredores que llegaron en la Maraton de Buenos Aires 2025 (resultados oficiales, raceresult 361890). largada_seg: segundo en que cruzaron la largada despues del disparo. tiempo_neto_seg: tiempo neto oficial. paso_*_seg: tiempo neto al pasar por cada control (5 a 40 km y media maraton); vacio si el chip no lo registro. El modelo usa la largada y el tiempo neto; los pasos son la base de los flujos reales de la tabla puestos.')
INSERT INTO AL_TABLES VALUES('insumos',NULL,'Insumos que se compran para los puestos. precio: pesos por unidad_precio. capacidad_fija: stock por puesto cuando no se calcula segun la demanda. unidades_por_corredor: fruta y gel por corredor que pasa (la bebida se calcula con la ingesta). contenido_ml: lo que entra en un vaso. Valores de ejemplo, ver el informe.')
INSERT INTO AL_TABLES VALUES('planes_relevamiento',NULL,'Temperaturas en las que se midio el consumo (experimento Relevamiento, 5 semillas, C = 0,114) y cuantos puestos tenia el plan medido a esa temperatura.')
INSERT INTO AL_TABLES VALUES('puestos',NULL,'Los 15 puestos reales, en el orden del recorrido (cada fila es un agente Puesto). km y oferta: shapefile puestos_hidratacion3 (los geles de km 22,6 y 30 se agregaron). calle: OpenStreetMap (Nominatim). latitud/longitud: nodo del puesto en el recorrido GIS. lat/lon_estacionamiento: donde estaciona el camion de reposicion (~130 m del circuito). pico_real_por_min, minuto_pico_real, flujo_medio_real (90 % central del peloton) y fin_ventana_real (minuto en que paso el 95 %): carrera real 2025, interpolando los pasos de la tabla corredores (Datos/preparar_datos_modelo.py). barrio, entorno (0 = edificios, 1 = parque, 2 = mixto, edificios y parques en 120 m) y cerca_del_agua: OpenStreetMap; solo decoran la escena 3D.')
INSERT INTO AL_TABLES VALUES('retiro_planificado',NULL,'Unidades por corredor que se colocan en cada puesto en el escenario optimo, segun la temperatura planificada: media + 1,65 desvios de la demanda por corredor medida en el Relevamiento (Datos/experimentos/relevamiento_v3_*.csv). 0 = el puesto no da ese insumo o no se arma.')
INSERT INTO AL_TABLES VALUES('vehiculos',NULL,'Reposicion. El camion sale del deposito (latitud/longitud_salida) y recorre la distancia en linea recta por factor_recorrido (las calles no son rectas). La zorra la lleva un operario desde el camion estacionado hasta la mesa; costo_hora es lo que cuesta el operario.')
