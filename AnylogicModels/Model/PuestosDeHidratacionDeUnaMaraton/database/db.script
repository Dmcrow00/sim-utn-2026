CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE MEMORY TABLE PUBLIC.AL_CONFIGURATION(PROPERTY_NAME VARCHAR(255) NOT NULL,PROPERTY_VALUE VARCHAR(16777216),UNIQUE(PROPERTY_NAME))
CREATE MEMORY TABLE PUBLIC.AL_GROUPS(GROUP_NAME VARCHAR(255) NOT NULL PRIMARY KEY,DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_TABLES(TABLE_NAME VARCHAR(255) NOT NULL PRIMARY KEY,GROUP_NAME VARCHAR(255),DESCRIPTION VARCHAR(16777216))
CREATE MEMORY TABLE PUBLIC.AL_CUSTOM_TYPE(TABLE_NAME VARCHAR(255),COLUMN_NAME VARCHAR(255),TYPE VARCHAR(255),NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.AL_VIEWS(VIEW_NAME VARCHAR(255) NOT NULL,VIEW_DEFINITION VARCHAR(16777216),IS_VALID BOOLEAN,UNIQUE(VIEW_NAME))
CREATE MEMORY TABLE PUBLIC.AL_SELECTED_LOG_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.AL_DB_OBJECTS(NAME VARCHAR(255) NOT NULL,TYPE VARCHAR(255),USAGE VARCHAR(255),UNIQUE(NAME))
CREATE MEMORY TABLE PUBLIC.CORREDORES(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,DORSAL INTEGER,LARGADA_SEG INTEGER,TIEMPO_NETO_SEG INTEGER,PASO_5K_SEG INTEGER,PASO_10K_SEG INTEGER,PASO_15K_SEG INTEGER,PASO_20K_SEG INTEGER,PASO_MEDIA_SEG INTEGER,PASO_25K_SEG INTEGER,PASO_30K_SEG INTEGER,PASO_35K_SEG INTEGER,PASO_40K_SEG INTEGER)
ALTER TABLE PUBLIC.CORREDORES ALTER COLUMN AL_ID RESTART WITH 12792
CREATE MEMORY TABLE PUBLIC.PUESTOS(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NUMERO INTEGER,KM DOUBLE,CALLE VARCHAR(16777216),LATITUD DOUBLE,LONGITUD DOUBLE,DA_AGUA BOOLEAN,DA_ISOTONICA BOOLEAN,DA_FRUTA BOOLEAN,DA_GEL BOOLEAN,LAT_ESTACIONAMIENTO DOUBLE,LON_ESTACIONAMIENTO DOUBLE,PICO_REAL_POR_MIN DOUBLE,MINUTO_PICO_REAL DOUBLE,FLUJO_MEDIO_REAL DOUBLE,FIN_VENTANA_REAL DOUBLE,BARRIO VARCHAR(16777216),ENTORNO INTEGER,CERCA_DEL_AGUA BOOLEAN)
ALTER TABLE PUBLIC.PUESTOS ALTER COLUMN AL_ID RESTART WITH 15
CREATE MEMORY TABLE PUBLIC.CATEGORIAS(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CATEGORIA INTEGER,NOMBRE VARCHAR(16777216),TIEMPO_NETO_MAX_MIN DOUBLE,CADENCIA_MINIMA DOUBLE,CADENCIA_DESVIO DOUBLE,CADENCIA_MEDIA DOUBLE,ZANCADA_MINIMA DOUBLE,ZANCADA_DESVIO DOUBLE,ZANCADA_MEDIA DOUBLE,NECESIDAD_HIDRATACION DOUBLE,TOLERANCIA_CALOR_MIN DOUBLE,TOLERANCIA_CALOR_MAX DOUBLE,FACTOR_TIEMPO_PUESTO DOUBLE,RESISTENCIA_FATIGA DOUBLE,PROPENSION_MIN DOUBLE,PROPENSION_MAX DOUBLE,INTERVALO_TOMA_MIN_KM DOUBLE,INTERVALO_TOMA_MAX_KM DOUBLE)
ALTER TABLE PUBLIC.CATEGORIAS ALTER COLUMN AL_ID RESTART WITH 4
CREATE MEMORY TABLE PUBLIC.INSUMOS(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,INSUMO VARCHAR(16777216),UNIDAD_PRECIO VARCHAR(16777216),PRECIO DOUBLE,CAPACIDAD_FIJA DOUBLE,UNIDADES_POR_CORREDOR DOUBLE,CONTENIDO_ML DOUBLE)
ALTER TABLE PUBLIC.INSUMOS ALTER COLUMN AL_ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.VEHICULOS(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,VEHICULO VARCHAR(16777216),VELOCIDAD_KMH DOUBLE,CAPACIDAD_UNIDADES DOUBLE,COSTO_HORA DOUBLE,LATITUD_SALIDA DOUBLE,LONGITUD_SALIDA DOUBLE,FACTOR_RECORRIDO DOUBLE)
ALTER TABLE PUBLIC.VEHICULOS ALTER COLUMN AL_ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.PLANES_RELEVAMIENTO(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TEMPERATURA_PLAN INTEGER,PUESTOS_DEL_PLAN INTEGER)
ALTER TABLE PUBLIC.PLANES_RELEVAMIENTO ALTER COLUMN AL_ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.RETIRO_PLANIFICADO(AL_ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TEMPERATURA_PLAN INTEGER,PUESTO INTEGER,AGUA DOUBLE,ISOTONICA DOUBLE,FRUTA DOUBLE,GEL DOUBLE)
ALTER TABLE PUBLIC.RETIRO_PLANIFICADO ALTER COLUMN AL_ID RESTART WITH 75
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
